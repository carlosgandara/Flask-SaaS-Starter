# Copy to .env. Never commit the real .env or any API/webhook secret.
# Generate JWT_SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
DATABASE_URL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_DISPLAY_NAME=MyApp
BASE_URL=http://localhost:5000
COOKIE_SECURE=False

# Optional billing. Disabled until real provider IDs and credentials are supplied.
BILLING_ENABLED=false
BILLING_MODE=test
BILLING_PLANS='{}'
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=50570
LEMONSQUEEZY_API_KEY=

# Local development only. Live billing requires redis:// or rediss://.
RATELIMIT_STORAGE_URI=memory://
